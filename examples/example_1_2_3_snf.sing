// Examples 1-3 of the paper: an H-monomial in the first Weyl algebra, and
// SAGBI normal forms SNF(g|H) (Algorithm 1) in U(sl_2) and in the second
// Weyl algebra, with the degree reverse lexicographical ordering dp.
option(noredefine);
LIB "ncsagbi.lib";

"Example 1: m(H) = h1*h2 in A_1";
ring r1 = 0, (x, d), dp;
def A1 = Weyl(); setring A1;             // d*x = x*d + 1
poly h1 = x^2*d + 1; poly h2 = 2*x*d - d;
h1*h2;

"Example 2: SNF(g|H) in U(sl_2)";
ring r = 0, (e, f, h), dp;
matrix C[3][3]; C[1,2]=1; C[1,3]=1; C[2,3]=1;
matrix D[3][3]; D[1,2]=-h; D[1,3]=2e; D[2,3]=-2f;
def U = nc_algebra(C, D);  // f*e = e*f - h, h*e = e*h + 2e, h*f = f*h - 2f
setring U;
ideal H = e^2, f, f*h + f;
poly g = e^2*f*h + e*h + f;
snf(g, H);

"Example 3: SNF(g|H) in A_2";
ring r3 = 0, (x1, x2, d1, d2), dp;
def A2 = Weyl(); setring A2;             // d1*x1 = x1*d1 + 1, d2*x2 = x2*d2 + 1
ideal H = x2^2*d1 - 1, x1*d2 + 1;
poly g = x1*d1^2*x2^4*d2 + x1*x2^2 + x2^2*d1^3;
snf(g, H);
quit;
