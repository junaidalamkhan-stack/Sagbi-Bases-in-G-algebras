// Example 6 of the paper: SAGBI basis of the subalgebra generated by
// H = {e, h^2} in U(sl_2), lexicographical ordering; result {e, h^2, e*h + e}.
option(noredefine);
LIB "ncsagbi.lib";
ring r = 0, (e, f, h), lp;
matrix C[3][3]; C[1,2]=1; C[1,3]=1; C[2,3]=1;
matrix D[3][3]; D[1,2]=-h; D[1,3]=2e; D[2,3]=-2f;
def U = nc_algebra(C, D);  // f*e = e*f - h, h*e = e*h + 2e, h*f = f*h - 2f
setring U;
ideal H = e, h^2;
ideal SB = ncsagbi(H, 10);
SB;
quit;
