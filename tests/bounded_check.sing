// Bounded independent check of SAGBI bases: all products of elements of SB
// of total degree <= D are formed (in the G-algebra), the leading monomials
// of their K-span are computed by Gaussian elimination, and each is tested
// for being a product of leading monomials of SB.  A leading monomial
// outside that monoid proves that SB is NOT a SAGBI basis; none up to degree
// D is evidence (not a proof) that SB is one.  The generating set of
// Example 7 serves as a negative control.
option(noredefine);
LIB "ncsagbi.lib";
proc lmMonoid(ideal SB, int D)
{
  // exponent vectors (as monomials) reachable as products of LM(SB), degree <= D
  ideal L = 1; ideal M = 1; int changed = 1; int i; int j;
  while (changed) {
    changed = 0;
    for (i = 1; i <= ncols(M); i++) {
      for (j = 1; j <= ncols(SB); j++) {
        poly m = leadmonom(M[i]) * leadmonom(SB[j]);  // nc product; LM is the commutative product
        m = leadmonom(m);
        if (deg(m) <= D) {
          if (1) {
            int found = 0; int k;
            for (k = 1; k <= ncols(L); k++) { if (L[k] == m) { found = 1; break; } }
            if (!found) { L[ncols(L)+1] = m; M[ncols(M)+1] = m; changed = 1; }
          }
        }
      }
    }
  }
  return(L);
}
proc boundedCheck(ideal SB, int D)
{
  // words in SB of degree <= D
  list W = list(poly(1)); list Wd = list(0); int i; int j; int n = 1;
  while (n <= size(W)) {
    for (j = 1; j <= ncols(SB); j++) {
      if (Wd[n] + deg(SB[j]) <= D) { W = W + list(W[n] * SB[j]); Wd = Wd + list(Wd[n] + deg(SB[j])); }
    }
    n++;
  }
  // K-span with distinct leading monomials
  list B; int k; int red;
  for (i = 1; i <= size(W); i++) {
    poly p = W[i];
    red = 1;
    while (p != 0 && red) {
      red = 0;
      for (k = 1; k <= size(B); k++) {
        if (leadmonom(B[k]) == leadmonom(p)) { p = p - leadcoef(p)/leadcoef(B[k]) * B[k]; red = 1; break; }
      }
    }
    if (p != 0) { B = B + list(p); }
  }
  ideal L = lmMonoid(SB, D + 4);
  int bad = 0;
  for (k = 1; k <= size(B); k++) {
    int ok = 0; int t;
    for (t = 1; t <= ncols(L); t++) { if (L[t] == leadmonom(B[k])) { ok = 1; break; } }
    if (!ok) { bad++; if (bad <= 3) { "  leading monomial not in the LM-monoid:", leadmonom(B[k]), " from ", B[k]; } }
  }
  "  products of degree <= " + string(D) + ": " + string(size(W)) + " words, span of dimension " + string(size(B)) + ", leading monomials outside the LM-monoid: " + string(bad);
}
"Example 5:";
ring r5 = 0, (x, d), lp; def A1 = Weyl(); setring A1;
ideal SB = ncsagbi(ideal(x^2, x*d, d^2), 10);
boundedCheck(SB, 10);

"Example 6:";
ring r = 0, (e, f, h), lp;
matrix C[3][3]; C[1,2]=1; C[1,3]=1; C[2,3]=1;
matrix D[3][3]; D[1,2]=-h; D[1,3]=2e; D[2,3]=-2f;
def U = nc_algebra(C, D);  // f*e = e*f - h, h*e = e*h + 2e, h*f = f*h - 2f
setring U;
ideal SB = ncsagbi(ideal(e, h^2), 10);
boundedCheck(SB, 8);

"Generating set of Example 7 (negative control):";
ideal H = h, e^2, f^2, e*f*h;
boundedCheck(H, 8);
quit;
